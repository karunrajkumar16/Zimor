# Zimor Backend API Environment Configuration
PORT=5001
# In development: http://localhost:3000
# In production: MUST be explicitly set to the production frontend URL (e.g., https://frontend-rho-gilt-51.vercel.app)
CLIENT_URL=http://localhost:3000
NODE_ENV=development

# Optional: Comma-separated list of explicitly approved Vercel preview origins
APPROVED_PREVIEW_ORIGINS=https://frontend-rho-gilt-51.vercel.app

# Database (Production MongoDB Atlas or set USE_MOCK_DB=true for local JSON fallback)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.ro0fmvq.mongodb.net/zimor?retryWrites=true&w=majority
USE_MOCK_DB=false

# Media Storage (Cloudinary - Used for image signature generation and secure assets)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
USE_MOCK_MEDIA=false

# Payment Processing (Razorpay - Webhook signature verification and payment capture)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
USE_MOCK_PAYMENT=false

# Admin Authentication Allowlist (Strict 2-Account Control)
ADMIN_ALLOWED_EMAILS=karunsingh1602@gmail.com,zimorindia@gmail.com
ADMIN_JWT_SECRET=your_jwt_secret_32_characters_minimum

# Google OAuth 2.0 (Keep Secret strictly on backend)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# In production: https://<backend-project-domain>.vercel.app/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback

# Shiprocket Logistics Integration
SHIPROCKET_LOGISTICS_MODE=mock
SHIPROCKET_ENV=staging
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_ORDER_CREATION_ENABLED=false
SHIPROCKET_MUTATIONS_ENABLED=false
SHIPROCKET_API_EMAIL=your_shiprocket_email@example.com
SHIPROCKET_API_PASSWORD=your_shiprocket_password
SHIPROCKET_WEBHOOK_TOKEN=your_shiprocket_webhook_secret_token
