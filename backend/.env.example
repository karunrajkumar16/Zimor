# Zimor Backend API Environment Configuration
PORT=5001
CLIENT_URL=http://localhost:3000
NODE_ENV=development

# Database (Production MongoDB Atlas or set USE_MOCK_DB=true for local JSON fallback)
MONGODB_URI=mongodb+srv://username:password@cluster0.ro0fmvq.mongodb.net/zimor?retryWrites=true&w=majority
USE_MOCK_DB=false

# Media Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
USE_MOCK_MEDIA=false

# Payment Processing
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
USE_MOCK_PAYMENT=true

# Admin Authentication (Strict Two-Account Allowlist)
ADMIN_ALLOWED_EMAILS=karunsingh1602@gmail.com,zimorindia@gmail.com
ADMIN_JWT_SECRET=your_jwt_secret_32_characters_minimum

# Google OAuth 2.0 (Keep Secret strictly on backend)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback
